# =================================================================
# RecruitX SaaS Platform - Production Environment Configuration
# Copy this file to server/.env and adjust credentials before launch
# =================================================================

# Server Network & Environment
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# Authentication & Cryptography
JWT_SECRET=recruitx_super_secret_production_jwt_key_9876543210_change_in_prod
JWT_EXPIRES_IN=7d

# Google Gemini Generative AI (Assessment & Multimodal Vision)
# Active Model: gemini-3.6-flash (Failover: gemini-3.5-flash-lite)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Firebase Cloud Firestore Credentials
# Option A: JSON key file path (e.g. ./serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: Inline Service Account Credentials
FIREBASE_PROJECT_ID=recruitx-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@recruitx-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email Services (Resend API / SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=RecruitX Placements <onboarding@resend.dev>

# File Upload Storage
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=5
