# ==============================================================================
# Dockerfile.auth  –  RecruitX Login/Registration Service (Task 4)
#
# Stage 1: Build React Frontend (Login + Register pages)
# Stage 2: Build Node.js TypeScript Backend (Auth API + Firebase DB)
# Stage 3: Minimal production runtime – serves both UI and API on port 5000
# ==============================================================================

# ─── STAGE 1: React Client Build ────────────────────────────────────────────
FROM node:20-alpine AS client-builder
LABEL stage=client-builder

WORKDIR /app/client

# Install dependencies first (layer cache friendly)
COPY client/package*.json ./
RUN npm ci --prefer-offline

# Copy source and build
COPY client/ ./
RUN npm run build
# Output: /app/client/dist


# ─── STAGE 2: Node.js / TypeScript Backend Build ────────────────────────────
FROM node:20-alpine AS server-builder
LABEL stage=server-builder

WORKDIR /app/server

# Install ALL dependencies (including devDependencies for tsc)
COPY server/package*.json ./
RUN npm ci --prefer-offline

# Copy source and compile TypeScript → dist/
COPY server/ ./
RUN npm run build
# Output: /app/server/dist


# ─── STAGE 3: Production Runtime ─────────────────────────────────────────────
FROM node:20-alpine AS production-runtime
LABEL maintainer="RecruitX DevOps Task 4"
LABEL description="Login/Registration App with Firebase Database Connectivity"

WORKDIR /app/server

ENV NODE_ENV=production
ENV PORT=5000

# Install production-only server dependencies
COPY server/package*.json ./
RUN npm ci --only=production --prefer-offline

# Copy compiled backend
COPY --from=server-builder /app/server/dist ./dist

# Copy built React frontend (served statically by Express in production)
COPY --from=client-builder /app/client/dist ../client/dist

# Create uploads directory for file storage
RUN mkdir -p uploads

# Expose HTTP port
EXPOSE 5000

# Container health check – verifies Auth API + DB connection
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/health || exit 1

# Start the application
CMD ["node", "dist/server.js"]
