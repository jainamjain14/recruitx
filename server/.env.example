PORT=5000
NODE_ENV=development

# Firebase Cloud Firestore Configuration
# Option 1: Firebase Service Account Credentials via env variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to serviceAccountKey.json file downloaded from Firebase Console
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_EXPIRES_IN_REMEMBER=7d
CLIENT_URL=http://localhost:5173

# AI Model Integration Keys
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=
RESEND_API_KEY=your_resend_api_key

# Optional: Verified Custom Domain Sender in Resend
# RESEND_FROM_EMAIL="RecruitX Applications <applications@yourdomain.com>"

# Optional: Direct all outgoing candidate applications to a specific HR testing inbox during demos
# COMPANY_HR_EMAIL_OVERRIDE=hr.evaluator@gmail.com

