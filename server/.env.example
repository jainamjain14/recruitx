PORT=5000
NODE_ENV=development

# Firebase Cloud Firestore Configuration
# Option 1: Firebase Service Account Credentials via env variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to serviceAccountKey.json file downloaded from Firebase Console
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_EXPIRES_IN_REMEMBER=7d
CLIENT_URL=http://localhost:5173

# AI Model Integration Keys
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=

# Email Dispatch Configuration:
# Free Option 1: Gmail SMTP (No custom domain required, sends to ANY email address)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords (select App: Mail)
# 3. Use Port 587 with STARTTLS (Port 465 is often blocked by cloud hosts like Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM_NAME="RecruitX Security"

# Option 2: Resend API (requires verified custom domain at resend.com/domains for external recipients)
RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL="RecruitX Applications <applications@yourdomain.com>"

# Optional: Direct all outgoing candidate applications to a specific HR testing inbox during demos
# COMPANY_HR_EMAIL_OVERRIDE=hr.evaluator@gmail.com

